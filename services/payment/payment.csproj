<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lockfile ĐƯỢC COMMIT (packages.lock.json). Docker restore chạy ở locked mode nên
         hai lần build cùng một commit luôn kéo đúng cùng một cây NuGet; lockfile lệch
         csproj thì build FAIL thay vì âm thầm nâng version. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Chốt tên assembly để output publish (payment.dll) khớp ENTRYPOINT của Dockerfile,
         không phụ thuộc casing thư mục (NTFS case-insensitive) — cùng lý do như order. -->
    <AssemblyName>payment</AssemblyName>
  </PropertyGroup>

</Project>
